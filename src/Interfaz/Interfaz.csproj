<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Nombre limpio del ejecutable y metadatos de ensamblado -->
    <AssemblyName>NEXUS</AssemblyName>
    <RootNamespace>Interfaz</RootNamespace>
    <ApplicationIcon>Assets\nexus_icon.ico</ApplicationIcon>
    <Product>NEXUS</Product>
    <Authors>Sebastián Zubieta Quiroga</Authors>
    <Company>UNIFRANZ - Ingeniería de Sistemas</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Simulador Multiversal NEXUS con módulo didáctico de C#</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
  </ItemGroup>

</Project>